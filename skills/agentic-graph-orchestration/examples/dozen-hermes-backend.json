{
  "name": "dozen-hermes-backend",
  "goal": "Finish remaining Dozen backend after PR #3: unpooled migrate, 0008 confirmation, queued-payout drain, webhook proof. UI stays with Grok. No GMV claim.",
  "stop": {
    "maxWallMinutes": 90,
    "noProgressSteps": 3
  },
  "nodes": [
    {
      "id": "preflight",
      "dependsOn": [],
      "owns": ["docs/TRUTH-AUDIT.md"],
      "closer": "script",
      "doneWhen": "main fetched, test count recorded, TRUTH-AUDIT read"
    },
    {
      "id": "fence-check",
      "dependsOn": ["preflight"],
      "owns": ["docs/HERMES-BACKEND.md"],
      "closer": "policy",
      "doneWhen": "agent will not edit src/routes/*.tsx, src/components, or src/lib/auth"
    },
    {
      "id": "rebase-unpooled",
      "dependsOn": ["fence-check"],
      "owns": ["scripts/migrate.mjs"],
      "closer": "script",
      "doneWhen": "migrate.mjs prefers DATABASE_URL_UNPOOLED or PR #4 is merged"
    },
    {
      "id": "schema-0008",
      "dependsOn": ["rebase-unpooled"],
      "owns": ["migrations/0008_dozen_webhook_connect.sql"],
      "closer": "human",
      "doneWhen": "Alex confirms _migrations contains 0008 on production Neon"
    },
    {
      "id": "drain",
      "dependsOn": ["fence-check"],
      "owns": ["src/lib/dozen/connect.ts", "src/lib/dozen/drain.ts"],
      "closer": "model",
      "doneWhen": "drainQueuedPayouts retries queued creator rows via transferOrQueue and payouts_enabled"
    },
    {
      "id": "drain-verify",
      "dependsOn": ["drain"],
      "owns": ["src/lib/dozen/wiring.test.ts"],
      "verifies": ["drain"],
      "closer": "policy",
      "doneWhen": "unit+wiring tests prove queued-only, payouts_enabled gate, no duplicate insert"
    },
    {
      "id": "webhook-proof",
      "dependsOn": ["schema-0008"],
      "owns": ["docs/BUILD-REPORT.md"],
      "closer": "human",
      "doneWhen": "unsigned POST is 400 bad-sig; signed test event 200; replay duplicate"
    },
    {
      "id": "full-verify",
      "dependsOn": ["drain-verify", "rebase-unpooled"],
      "owns": ["docs/workgraphs/dozen-hermes-backend.json"],
      "verifies": ["drain-verify", "rebase-unpooled"],
      "closer": "script",
      "doneWhen": "npx tsx --test src/lib/dozen/*.test.ts pass at >=93 and vite build passes"
    },
    {
      "id": "deploy",
      "dependsOn": ["full-verify", "webhook-proof"],
      "owns": ["vercel-production"],
      "closer": "human",
      "irreversible": true,
      "doneWhen": "Alex confirms Production env and deploy"
    },
    {
      "id": "merge",
      "dependsOn": ["full-verify"],
      "owns": ["github-merge"],
      "closer": "human",
      "irreversible": true,
      "doneWhen": "Alex merges the backend PR"
    },
    {
      "id": "remember",
      "dependsOn": ["full-verify"],
      "owns": ["gbrain-memory"],
      "closer": "policy",
      "irreversible": true,
      "doneWhen": "no unverified memory write; skip unless a policy-approved learning exists"
    }
  ],
  "loops": [
    {
      "id": "drain-loop",
      "maxAttempts": 2,
      "nodes": ["drain", "drain-verify"]
    }
  ]
}
